@inject GameSession Session

@* Training tab: how many of each unit to start training on this hex.
   Each unit type trains in its building type (dot→plane, circle→dome, triangle→pyramid, square→cube). *@

@{
    var settings = Session.Current.GameSettings;
    var draft = Session.GetDraft(PlayerId, Hexagon);
    var compound = Session.Current.PlayerStates[PlayerId].Compounds.GetValueOrDefault(Hexagon, Compound.Empty);
}

@if (compound.IsEmpty)
{
    <MudAlert Severity="Severity.Info" Dense="true">No training buildings on this hex.</MudAlert>
}
else
{
    @foreach (var unit in BoardGlyphs.Units)
    {
        var trainingBuilding = GameSettings.TrainingBuildingPerUnit[unit];
        short buildings = compound[trainingBuilding];
        if (buildings <= 0)
        {
            continue;
        }
        int value = draft?.Training[unit] ?? 0;
        <div class="d-flex align-center gap-2 mb-1">
            <MudText Typo="Typo.body2" Style="width: 110px;">
                @BoardGlyphs.TextGlyph(unit) @BoardGlyphs.DisplayName(unit)
            </MudText>
            <MudNumericField T="int"
                             Value="value"
                             ValueChanged="newValue => Set(unit, newValue)"
                             Min="0" Max="999"
                             Variant="Variant.Outlined" Margin="Margin.Dense"
                             Style="width: 84px;" />
            <MudText Typo="Typo.caption" Class="mud-text-secondary">
                ◈ @settings.ArmyCost[unit] · ↻ @settings.TrainingDuration[unit] · ⌂ @settings.RequiredSpace[unit]
                · @buildings× @trainingBuilding
            </MudText>
        </div>
    }
    <MudText Typo="Typo.caption" Class="mud-text-secondary d-block mt-2">
        A building trains one unit at a time (including queued trainings).
    </MudText>
}

@code {
    [Parameter, EditorRequired] public string PlayerId { get; set; } = default!;
    [Parameter, EditorRequired] public Hexagon Hexagon { get; set; }

    private void Set(Unit unit, int value) =>
        Session.UpdateDraft(PlayerId, Hexagon, draft => draft.Training[unit] = Math.Max(0, value));
}
